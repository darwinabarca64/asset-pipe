# ==============================================================================
# ASSET-PIPE: CLEAN ENVIRONMENT TEMPLATE (OPSEC ZERO-LEAK STANDARD)
# Copy this file to .env for local execution. Never commit .env to version control.
# ==============================================================================

# [RUNTIME & WEB INTERFACES]
APP_ENV=development
PORT=3000
SQL_UI_PORT=4213

# [S3 / MINIO MEDALLION LAKEHOUSE STORAGE]
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_CONSOLE_URL=http://localhost:9001
S3_ACCESS_KEY=admin
S3_SECRET_KEY=assetpipe2026
S3_BUCKET_LANDING=landing
S3_BUCKET_VALIDATED=validated-parquet
S3_BUCKET_QUARANTINE=quarantine

# [DUAL WAREHOUSE ENGINE & FINOPS ROUTING]
# Options: duckdb | snowflake
WAREHOUSE_ENGINE=duckdb
DUCKDB_PATH=data/asset_pipe.duckdb

# [SNOWFLAKE ENTERPRISE CLOUD CONFIGURATION (KEY-PAIR RSA AUTH)]
SNOWFLAKE_ACCOUNT=org-account_identifier
SNOWFLAKE_USER=ASSET_PIPE_SVC_USER
SNOWFLAKE_ROLE=ASSET_PIPE_SVC_ROLE
SNOWFLAKE_WAREHOUSE=ASSET_PIPE_WH
SNOWFLAKE_DATABASE=ASSET_PIPE_DB
SNOWFLAKE_SCHEMA=RECONCILIATION
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/rsa_key.p8
